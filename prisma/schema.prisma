// Club Ciocolatto — Prisma schema
// Decisions documented in docs/database.md and docs/loyalty-system.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

enum PointTransactionType {
  EARN
  REDEEM
  BONUS
  REFUND
  ADJUSTMENT
  EXPIRATION
}

enum PointSource {
  PURCHASE
  REGISTRATION
  FIRST_PURCHASE
  BIRTHDAY
  REFERRAL_SPONSOR
  REFERRAL_REFEREE
  MISSION
  PROMOTION
  MANUAL_ADMIN
  REDEMPTION
  REDEMPTION_CANCELLED
  ANNIVERSARY
  VISIT_STREAK
  PROFILE_COMPLETION
  SURVEY_RESPONSE
  CLAIM_APPROVED
  // Ya no se otorga (reglas 2026 sacaron el bono dúo) — se conserva para no
  // perder el historial de lo ya pagado en PointTransaction/Referral.
  REFERRAL_DUO
  // Puntos extra por el multiplicador de nivel en una compra (reglas 2026).
  // Separado de PURCHASE a propósito: no cuenta para la ventana de 12 meses
  // que define el nivel (regla: "cuenta el punto base, no el extra").
  TIER_BONUS
  // Vencimiento real por inactividad (reglas 2026) — ver /api/cron/points-expiry.
  POINTS_EXPIRED
}

enum MissionType {
  PURCHASE_COUNT
  VISIT_COUNT
  SPEND_AMOUNT
  PRODUCT_PURCHASE
  CATEGORY_PURCHASE
  REFERRAL
  SPECIAL_DATE
  RAINY_DAY
  CUSTOM
}

enum MissionProgressStatus {
  IN_PROGRESS
  COMPLETED
  REWARD_CLAIMED
  EXPIRED
}

enum RedemptionStatus {
  PENDING
  USED
  EXPIRED
  CANCELLED
}

enum RewardCategory {
  PRODUCT
  DISCOUNT
}

enum ReferralStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum PointClaimType {
  SOCIAL_MEDIA_POST
  REVIEW
  CUSTOM
}

enum PointClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PromotionType {
  POINTS_MULTIPLIER
  BONUS_POINTS
  DISCOUNT
}

enum NotificationType {
  POINTS_EARNED
  POINTS_REDEEMED
  TIER_UPGRADED
  MISSION_COMPLETED
  REWARD_UNLOCKED
  BIRTHDAY
  REFERRAL_COMPLETED
  GENERAL
  ANNIVERSARY
  WINBACK
  POINTS_EXPIRING
  ANNOUNCEMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  PUSH
}

enum OrderSource {
  MANUAL_EMPLOYEE
  POS_INTEGRATION
  ADMIN
}

enum OrderStatus {
  COMPLETED
  REFUNDED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  phone               String?   @unique
  passwordHash        String
  role                Role      @default(CUSTOMER)
  firstName           String
  lastName            String
  birthDate           DateTime? @db.Date
  favoriteDrink       String? // e.g. "Latte" — used for the automatic birthday free-coffee gift
  avatarUrl           String?
  active              Boolean   @default(true)
  acceptedTermsAt     DateTime?
  acceptedMarketingAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customerProfile     CustomerProfile?
  employeeOrders      Order[]              @relation("OrderEmployee")
  auditLogs           AuditLog[]           @relation("AuditActor")
  notifications       Notification[]
  redeemedByEntries   RewardRedemption[]   @relation("RedeemedByEmployee")
  passwordResetTokens PasswordResetToken[]
  reviewedPointClaims PointClaim[]         @relation("PointClaimReviewer")
  pushSubscriptions   PushSubscription[]

  @@index([role])
}

// One per CUSTOMER-role user. Kept separate from User so employee/admin
// accounts never carry loyalty fields, and so the loyalty engine only ever
// deals with a narrow, purpose-built shape.
model CustomerProfile {
  id                           String       @id @default(cuid())
  userId                       String       @unique
  user                         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsBalance                Int          @default(0) // spendable balance — reconstructable as SUM(PointTransaction.amount)
  lifetimePoints               Int          @default(0) // status/tier basis — never reduced by REDEEM or EXPIRATION
  tierId                       String?
  tier                         LoyaltyTier? @relation(fields: [tierId], references: [id])
  qrToken                      String       @unique // opaque, cryptographically random identifier embedded in the customer's QR (see src/lib/codes.ts)
  referralCode                 String       @unique
  totalSpent                   Decimal      @default(0) @db.Decimal(12, 2)
  totalOrders                  Int          @default(0)
  firstOrderAt                 DateTime?
  lastOrderAt                  DateTime?
  birthdayRewardClaimedYear    Int?
  anniversaryRewardClaimedYear Int?
  visitStreakWeeks             Int          @default(0)
  visitStreakWeekIndex         Int? // Monday-aligned week counter in business-local time, see src/lib/timezone.ts
  visitStreakMilestoneWeeks    Int          @default(0)
  profileCompletionAwardedAt   DateTime?
  lastWinbackSentAt            DateTime?
  lastPointsExpiryWarningAt    DateTime?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  pointTransactions PointTransaction[]
  orders            Order[]
  missionProgress   MissionProgress[]
  redemptions       RewardRedemption[]
  referralsSent     Referral[]         @relation("Referrer")
  referralReceived  Referral?          @relation("Referee")
  pointClaims       PointClaim[]
  surveyResponse    SurveyResponse?

  @@index([tierId])
  @@index([lastOrderAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Loyalty core
// ─────────────────────────────────────────────────────────────────────────

model LoyaltyTier {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  minimumPoints  Int
  maximumPoints  Int?
  description    String?
  benefits       Json // string[] — texto libre mostrado al cliente, no leído por la lógica de puntos
  // Multiplicador de puntos por compra de este nivel (1 = sin cambio, 1.25 =
  // +25%). No se acumula con la promoción de puntos dobles — se aplica el
  // mayor de los dos (ver computeOrderPoints en order-service.ts). Los
  // puntos extra que da este multiplicador no cuentan para el umbral de
  // nivel: ver PointSource.TIER_BONUS.
  earnMultiplier Decimal  @default(1) @db.Decimal(4, 2)
  icon           String?
  color          String?
  displayOrder   Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customers          CustomerProfile[]
  rewards            Reward[]
  winbackConfigs     LoyaltyConfig[]   @relation("WinbackMinimumTier")
  referralDuoConfigs LoyaltyConfig[]   @relation("ReferralDuoMilestoneTier")

  @@index([displayOrder])
}

// Append-only ledger. Balances are never mutated directly — every change to
// a customer's points is a row here, and pointsBalance/lifetimePoints on
// CustomerProfile are a cache that must always equal what this table
// recomputes. `amount` is signed (negative for redemptions/expirations) so
// balance = SUM(amount).
model PointTransaction {
  id                String               @id @default(cuid())
  customerProfileId String
  customerProfile   CustomerProfile      @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  type              PointTransactionType
  source            PointSource
  amount            Int
  balanceAfter      Int
  description       String
  referenceType     String? // e.g. "Order", "Mission", "RewardRedemption", "Referral"
  referenceId       String?
  metadata          Json?
  createdById       String? // admin/employee who triggered a manual adjustment
  createdAt         DateTime             @default(now())

  @@index([customerProfileId, createdAt])
  @@index([referenceType, referenceId])
  // Standalone (not customerProfileId-led) — serves the admin dashboard's
  // store-wide activity series, which filters by createdAt alone.
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Missions
// ─────────────────────────────────────────────────────────────────────────

model Mission {
  id           String      @id @default(cuid())
  name         String
  description  String
  icon         String?
  type         MissionType
  targetValue  Int
  productId    String?
  category     String?
  rewardPoints Int         @default(0)
  rewardId     String?
  startAt      DateTime?
  endAt        DateTime?
  perUserLimit Int         @default(1) // times a customer may complete this mission (cycles)
  segment      String? // segmentation key; null = all customers
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  reward   Reward?           @relation(fields: [rewardId], references: [id])
  product  Product?          @relation(fields: [productId], references: [id])
  progress MissionProgress[]

  @@index([active, startAt, endAt])
}

// One row per customer per mission "cycle" (cycleKey lets a monthly mission
// like "visit 3 times this month" restart automatically: cycleKey = "2026-08").
model MissionProgress {
  id                String                @id @default(cuid())
  missionId         String
  mission           Mission               @relation(fields: [missionId], references: [id], onDelete: Cascade)
  customerProfileId String
  customerProfile   CustomerProfile       @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  currentValue      Int                   @default(0)
  status            MissionProgressStatus @default(IN_PROGRESS)
  completedAt       DateTime?
  claimedAt         DateTime?
  cycleKey          String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([missionId, customerProfileId, cycleKey])
  @@index([customerProfileId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// Rewards
// ─────────────────────────────────────────────────────────────────────────

model Reward {
  id                    String         @id @default(cuid())
  name                  String
  description           String?
  imageUrl              String?
  icon                  String? // emoji shown in the customer store, e.g. "☕"
  category              RewardCategory @default(PRODUCT)
  pointsCost            Int
  stock                 Int? // null = unlimited
  requiredTierId        String?
  requiredTier          LoyaltyTier?   @relation(fields: [requiredTierId], references: [id])
  perUserLimit          Int? // null = unlimited
  validFrom             DateTime?
  validUntil            DateTime?
  // Visitas mínimas (histórico, desde que el socio se registró) para poder
  // canjear — hoy solo lo usan los "box sorpresa". Null = sin requisito.
  minimumVisits         Int?
  // Monto mínimo de la COMPRA en la que se usa el canje (se valida al
  // validar el código en caja, cuando ya se conoce el monto real). Null =
  // sin mínimo.
  minimumPurchaseAmount Decimal?       @db.Decimal(10, 2)
  // Porcentaje de descuento (ej. 10 = 10% OFF) — el descuento real se
  // calcula sobre saleAmount y se topea con discountCapAmount. Null si este
  // premio no es un %.
  discountPct           Decimal?       @db.Decimal(5, 2)
  // Descuento en pesos, monto fijo (ej. "$5.000 OFF") — se usa cuando
  // discountPct es null.
  discountFixedAmount   Decimal?       @db.Decimal(10, 2)
  // Tope en pesos del descuento que da este premio cuando es por %. Null =
  // sin tope.
  discountCapAmount     Decimal?       @db.Decimal(10, 2)
  // Tope de precio de lista del producto que se puede elegir al canjear
  // (ej. "café a elección hasta $6.000"). Null = sin tope / no aplica.
  maxProductPrice       Decimal?       @db.Decimal(10, 2)
  // Datos internos de costo — solo para referencia del admin, nunca se
  // muestran al socio (ver /admin/premios).
  internalListPrice     Decimal?       @db.Decimal(10, 2)
  internalCostCap       Decimal?       @db.Decimal(10, 2)
  internalNotes         String?
  active                Boolean        @default(true)
  hidden                Boolean        @default(false) // excluded from the customer store — for internal/automatic grants (e.g. the birthday coffee)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  redemptions RewardRedemption[]
  missions    Mission[]

  @@index([active])
}

model RewardRedemption {
  id                String           @id @default(cuid())
  customerProfileId String
  customerProfile   CustomerProfile  @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  rewardId          String
  reward            Reward           @relation(fields: [rewardId], references: [id])
  pointsSpent       Int
  redemptionCode    String           @unique
  status            RedemptionStatus @default(PENDING)
  expiresAt         DateTime?
  redeemedAt        DateTime?
  // Monto de la compra, ingresado por el empleado al validar el código en
  // caja (no se conoce al momento de generar el canje). Habilita el tope de
  // descuento y la compra mínima de `Reward`. Null si el premio no lo
  // necesita (ej. un café gratis sin condición de monto).
  saleAmount        Decimal?         @db.Decimal(10, 2)
  redeemedById      String?
  redeemedBy        User?            @relation("RedeemedByEmployee", fields: [redeemedById], references: [id])
  createdAt         DateTime         @default(now())

  @@index([customerProfileId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Catalog & orders
// ─────────────────────────────────────────────────────────────────────────

model Product {
  id               String   @id @default(cuid())
  name             String
  category         String?
  price            Decimal  @db.Decimal(10, 2)
  active           Boolean  @default(true)
  imageUrl         String?
  pointsMultiplier Decimal  @default(1) @db.Decimal(4, 2)
  bonusPoints      Int      @default(0)
  externalSku      String?  @unique // POS product id, for future integration
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems OrderItem[]
  missions   Mission[]
  promotions Promotion[]

  @@index([category])
}

model Order {
  id                String          @id @default(cuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  employeeId        String?
  employee          User?           @relation("OrderEmployee", fields: [employeeId], references: [id])
  source            OrderSource     @default(MANUAL_EMPLOYEE)
  status            OrderStatus     @default(COMPLETED)
  totalAmount       Decimal         @db.Decimal(10, 2)
  paymentMethod     String?
  externalReference String?         @unique // POS ticket/order id — enforces "same sale never earns points twice"
  pointsEarned      Int             @default(0)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items OrderItem[]

  @@index([customerProfileId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String // snapshot at time of sale
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────
// Growth
// ─────────────────────────────────────────────────────────────────────────

model Referral {
  id                    String          @id @default(cuid())
  referrerId            String
  referrer              CustomerProfile @relation("Referrer", fields: [referrerId], references: [id])
  refereeId             String          @unique
  referee               CustomerProfile @relation("Referee", fields: [refereeId], references: [id])
  codeUsed              String
  status                ReferralStatus  @default(PENDING)
  referrerPointsAwarded Int             @default(0)
  refereePointsAwarded  Int             @default(0)
  completedAt           DateTime?
  duoBonusPaidAt        DateTime?
  createdAt             DateTime        @default(now())

  @@index([referrerId, status])
}

model Promotion {
  id          String        @id @default(cuid())
  name        String
  description String?
  icon        String? // emoji key into BRAND_ICON_OPTIONS — shown on the home banner and /promociones instead of the generic per-type icon
  // Optional background image (Vercel Blob URL) for the home carousel slide
  // — rendered behind a dark gradient so the icon/title stay legible.
  imageUrl    String?
  // Optional external link (e.g. a wa.me URL) — shown as a "Enviar mensaje"
  // button on the promo's detail page (/promociones/[id]). For campaigns
  // fulfilled outside the app (e.g. "encargá la caja por WhatsApp"), not a
  // mechanical effect.
  ctaUrl      String?
  type        PromotionType
  multiplier  Decimal?      @db.Decimal(4, 2) // POINTS_MULTIPLIER
  bonusPoints Int? // BONUS_POINTS
  discountPct Decimal?      @db.Decimal(5, 2) // DISCOUNT
  category    String? // null = all categories
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id])
  segment     String? // segmentation key; null = all customers
  startAt     DateTime
  endAt       DateTime
  // Optional recurring time-of-day/day-of-week refinement, layered on top of
  // the startAt/endAt campaign window above (e.g. campaign runs Oct-Dec, but
  // only actually applies Tuesdays 15:00-18:00 within that range). Evaluated
  // in business-local time (see src/lib/timezone.ts) — Vercel runs in UTC.
  daysOfWeek  Int[]         @default([]) // 0=Sun..6=Sat (JS Date#getDay convention); [] = every day
  startMinute Int? // minutes since local midnight; null (with endMinute) = no time-of-day restriction
  endMinute   Int?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([active, startAt, endAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Platform
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  read      Boolean             @default(false)
  metadata  Json?
  createdAt DateTime            @default(now())

  @@index([userId, read, createdAt])
}

// One row per browser/device the customer opted into Web Push on. A user can
// have several (phone + laptop, etc.); a 410/404 response from the push
// service on send means the subscription expired and the row gets deleted.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String // e.g. ADMIN_ADDED_POINTS, REWARD_CREATED, CONFIG_UPDATED
  entityType String
  entityId   String?
  changes    Json?
  reason     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// Singleton row (id is always "singleton") holding every tunable of the
// loyalty program so none of it is hardcoded in application code.
model LoyaltyConfig {
  id                         String       @id @default("singleton")
  amountPerPoint             Decimal      @default(1000) @db.Decimal(10, 2) // $ spent per pointsPerAmount earned
  pointsPerAmount            Decimal      @default(1) @db.Decimal(10, 4)
  registrationPoints         Int          @default(30)
  firstPurchasePoints        Int          @default(50)
  birthdayPoints             Int          @default(100)
  // Flat per-referral bonus, superseded by the REFERRAL mission ladder
  // (1/5/10 friends — see prisma/seed.ts) as of 2026-08-29; kept at 0 so a
  // completed referral isn't paid twice. Still admin-editable if a flat
  // top-up on top of the ladder is ever wanted again.
  referralSponsorPoints      Int          @default(0)
  referralRefereePoints      Int          @default(100)
  // null = no expiran. Desde las reglas 2026: días SIN COMPRAS (no desde que
  // se ganó cada punto) después de los cuales vence todo lo que supere el
  // saldo protegido (ver getProtectedBalance en loyalty-service.ts, derivado
  // del ledger — no es una columna). 180 ≈ 6 meses.
  pointsExpireAfterDays      Int?
  redemptionCodeExpiryHours  Int          @default(72)
  rewardCooldownDays         Int?         // null = no cooldown; days before a customer can redeem the SAME reward again
  anniversaryPoints          Int          @default(150)
  profileCompletionPoints    Int          @default(50)
  surveyQuestion             String? // null = survey feature off
  surveyPoints               Int          @default(30)
  winbackInactivityDays      Int          @default(35)
  winbackMinimumTierId       String?
  winbackMinimumTier         LoyaltyTier? @relation("WinbackMinimumTier", fields: [winbackMinimumTierId], references: [id])
  // Ya no se otorga (reglas 2026) — ver REFERRAL_DUO. Se conservan estos dos
  // campos solo porque el admin podría querer revisarlos; sin lógica activa.
  referralDuoBonusPoints     Int          @default(100)
  referralDuoMilestoneTierId String?
  referralDuoMilestoneTier   LoyaltyTier? @relation("ReferralDuoMilestoneTier", fields: [referralDuoMilestoneTierId], references: [id])
  // ── Reglas 2026 (rebalanceo de puntos/premios/niveles) ──
  // Fecha en la que entran en vigencia las reglas nuevas. Null = todavía no
  // se activaron (toda la app sigue funcionando con las reglas viejas). No
  // hay congelamiento de nivel ni snapshot de saldo que hacer al activarla:
  // el nivel se recalcula en vivo para todos (rolling 12 meses) y el saldo
  // protegido se deriva del ledger — ninguno toca CustomerProfile.
  activationDate             DateTime?
  gracePeriodDays            Int          @default(15)
  // Monto mínimo de una compra para que cuente como "visita" (rachas, box
  // sorpresa, aniversario).
  visitMinimumAmount         Decimal      @default(8000) @db.Decimal(10, 2)
  boxUnlockVisits            Int          @default(8)
  anniversaryMinVisits       Int          @default(10)
  referralMinPurchaseAmount  Decimal      @default(10000) @db.Decimal(10, 2)
  winbackDiscountCap         Decimal      @default(3000) @db.Decimal(10, 2)
  winbackValidDays           Int          @default(15)
  winbackMaxFrequencyDays    Int          @default(90)
  // Se completa una sola vez, cuando el cron de activación aplica el
  // catálogo nuevo (precios/requisitos/cooldown) al terminar el período de
  // gracia. Null = todavía corre con el catálogo viejo (o nunca se activó).
  catalogFlippedAt           DateTime?
  businessName               String       @default("Ciocolatto")
  logoUrl                    String?
  contactEmail               String?
  contactPhone               String?
  instagramUrl               String?
  updatedAt                  DateTime     @updatedAt
}

// Customer self-report for a non-verifiable loyalty action (e.g. an
// Instagram post, a Google review) that an admin must manually approve
// before points are granted. Generic/reusable by `type` rather than a
// one-off table per action, so future non-automatable actions reuse this
// same queue.
model PointClaim {
  id                String           @id @default(cuid())
  customerProfileId String
  customerProfile   CustomerProfile  @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  type              PointClaimType
  description       String?
  proofUrl          String?
  pointsRequested   Int
  pointsAwarded     Int?
  status            PointClaimStatus @default(PENDING)
  reviewedById      String?
  reviewedBy        User?            @relation("PointClaimReviewer", fields: [reviewedById], references: [id])
  reviewNote        String?
  createdAt         DateTime         @default(now())
  reviewedAt        DateTime?

  @@index([status, createdAt])
  @@index([customerProfileId, type])
}

// One lifetime response per customer to the current LoyaltyConfig.surveyQuestion.
model SurveyResponse {
  id                String          @id @default(cuid())
  customerProfileId String          @unique
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  question          String // snapshot of config.surveyQuestion at time of answering
  answer            String
  createdAt         DateTime        @default(now())
}

// Credentials issued to the Ciocolatto POS for the future integration
// endpoints (/api/integrations/*). Only the hash is stored.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  hashedKey  String    @unique
  keyPrefix  String // shown in the admin UI to identify the key, e.g. "cc_live_ab12"
  scopes     Json // string[], e.g. ["orders:write", "customers:read", "refunds:write"]
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([active])
}

// Single-use, short-lived token for the "forgot password" email flow. Only
// the hash is stored (same pattern as ApiKey) so a DB leak alone can't be
// used to reset accounts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Generic idempotency store for integration endpoints beyond Order's own
// externalReference uniqueness (e.g. refunds), keyed by the caller-supplied
// Idempotency-Key header.
model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String   @unique
  endpoint     String
  responseBody Json?
  statusCode   Int?
  createdAt    DateTime @default(now())

  @@index([endpoint, createdAt])
}
