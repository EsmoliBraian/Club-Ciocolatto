# Database (local dev via docker-compose: postgresql://ciocolatto:ciocolatto_dev@localhost:5435/club_ciocolatto)
DATABASE_URL="postgresql://ciocolatto:ciocolatto_dev@localhost:5435/club_ciocolatto"
DIRECT_URL="postgresql://ciocolatto:ciocolatto_dev@localhost:5435/club_ciocolatto"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Club Ciocolatto"

# QR token signing (HMAC secret used to sign customer/redemption QR payloads)
QR_SECRET="generate-with-openssl-rand-base64-32"

# Integrations (future POS connector)
POS_API_KEY="generate-a-per-integration-api-key"
POS_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"

# Email (optional — leave blank to disable email notifications: password
# reset and birthday emails silently no-op instead of failing). Get a key at
# resend.com. RESEND_FROM_EMAIL needs a domain verified in Resend — until
# then it falls back to the shared onboarding@resend.dev sender.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Club Ciocolatto <onboarding@resend.dev>"

# Secret Vercel Cron sends as `Authorization: Bearer <value>` when it calls
# /api/cron/birthdays — set the same value in Vercel's env vars so only
# Vercel's own scheduler can trigger it. Optional locally.
CRON_SECRET=""

# Object storage (optional — leave blank to disable image uploads)
STORAGE_URL=""
STORAGE_KEY=""

# Seed accounts (development only — never reuse these values in production)
SEED_ADMIN_EMAIL="admin@ciocolatto.com"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
SEED_EMPLOYEE_EMAIL="empleado@ciocolatto.com"
SEED_EMPLOYEE_PASSWORD="change-me-before-seeding"
SEED_CUSTOMER_EMAIL="cliente@ciocolatto.com"
SEED_CUSTOMER_PASSWORD="change-me-before-seeding"
